# Copy this file to .env and fill in real values before running anything

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/truehire

# JWT secrets - use long random strings in real environments
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRY=30m
JWT_REFRESH_EXPIRY=7d

# Port the Express API listens on
PORT=5000

# Default admin account created by scripts/initDb.js
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@truehire.local
SEED_ADMIN_PASSWORD=ChangeMe123!
