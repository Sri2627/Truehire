# Copy this file to .env and fill in real values before running anything

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/truehire

# JWT secrets - use long random strings in real environments
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRY=30m
JWT_REFRESH_EXPIRY=7d

# Port the Express API listens on
PORT=5000

# Default admin account created by scripts/initDb.js
 
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=superadmin@truehire.local
SEED_ADMIN_PASSWORD=ChangeMe123!
# SMTP settings for actually sending candidate emails (interview
# invites) from the Candidates screen. If SMTP_HOST is left blank, sends
# are simulated (logged to the server console) instead of delivered -
# fine for local dev, but fill these in for real delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=True Hire <no-reply@truehire.local>
